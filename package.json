{
  "name": "frame-motion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/start-production.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx scripts/verify-render.ts",
    "test:landscape": "tsx scripts/verify-landscape.ts",
    "studio": "remotion studio src/video/index.ts --port 3001",
    "check:environment": "node scripts/check-environment.mjs",
    "test:ci": "node scripts/verify-ci.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/player": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "archiver": "7.0.1",
    "exifr": "7.1.3",
    "express": "5.1.0",
    "lucide-react": "0.468.0",
    "multer": "2.5.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.538",
    "sharp": "0.35.5",
    "zod": "4.6.7",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/archiver": "6.0.3",
    "@types/express": "5.0.5",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  },
  "overrides": {
    "zod": "$zod"
  }
}
